# Copy to .env and fill in. Never commit .env.

# Required: used by the LangChain chains (/suggest) and by /career
OPENAI_API_KEY=sk-your-key-here

# Optional: model for the /career endpoint (default: gpt-4o-mini).
# The /suggest chains use gpt-4o, set in app/utils/llm_config.py.
# OPENAI_MODEL=gpt-4o-mini

# Read in app/config.py but not used anywhere yet
# HUMBUGGING_API_TOKEN=
